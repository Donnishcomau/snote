#!/bin/bash
# Install snote for the Omarchy bar-button plugin's first-click setup.
# Runs in a visible terminal (see BarWidget.qml / omarchy-launch-
# floating-terminal-with-presentation). No sudo; nothing is written outside
# $HOME/.local.
#
# Nothing is built here anymore. The plugin's clone ships snote already
# built under plugin-dist/ (generated by the build:plugin script in the
# source repo and committed next to it), so first-click setup is a plain
# copy of pre-built, readable .js files plus the snote launcher. No npm,
# no download, no build.
#
# Why install outside the plugin's own clone (~/.config/omarchy/plugins/<id>):
# `omarchy plugin update`/`remove` manage that clone directory directly —
# mixing an installed payload into it risks the plugin manager clobbering
# it (or vice versa) and is not what that directory is for. XDG_DATA_HOME
# is exactly the right place for an application's own installed payload.
#
# Why NOT ~/.local/share/snote: snote itself already uses that directory
# for its own runtime data (see src/core/token.ts's XDG_DATA_HOME lookup),
# so an existing install may have real user data sitting there. This
# script's own directory must be a sibling that setup/uninstall can freely
# create and remove without ever touching that data.
set -eu

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
src_dir="$(cd "$here/../.." && pwd)"

log() { printf '==> %s\n' "$1"; }
fail() { printf 'snote setup: %s\n' "$1" >&2; exit 1; }

command -v realpath >/dev/null 2>&1 || fail "realpath is required but was not found on PATH"

# --- Base directories: resolve through symlinks, never refuse them -----
# XDG_DATA_HOME and ~/.local/bin are routinely symlinks in the wild —
# dotfile managers, a second disk, a bind mount — and that's normal, not
# a sign of anything wrong. Refusing to run because one of *those* is a
# symlink would lock real users out for no security benefit, and it's not
# what the reported finding was about ("that destination or its parent").
# So these two are resolved with `realpath -m` (follows symlinks, and
# tolerates a tail that doesn't exist yet on a first-ever install) and
# every path below is built from the resolved result, not the raw one.
data_home="$(realpath -m "${XDG_DATA_HOME:-$HOME/.local/share}")"
bin_dir="$(realpath -m "$HOME/.local/bin")"

plugin_dir="$data_home/omarchy-snote-plugin"
app_dir="$plugin_dir/app"
shim="$bin_dir/snote"
prev_dir="$plugin_dir/app.prev"
run_lock="$plugin_dir/run.lock"
rolled_back_mark="$plugin_dir/rolled-back"
checked_mark="$plugin_dir/checked"
dist_dir="$src_dir/plugin-dist"
# First line written into the shim so uninstall (and a future setup re-run)
# can tell "ours" apart from some other file/symlink a user or another tool
# left at the same path, without guessing from content shape.
shim_marker="# snote-omarchy-shim v1 (packaging/omarchy/setup) — safe to remove"

# A shim written by setup before this marker existed (0.1.2/0.1.3): a
# plain, small, regular file whose exec line names this plugin's own
# build path. Existing users who installed through the plugin before the
# marker was added have exactly this file at $shim with nothing else to
# identify it by — recognise it by that exec line so their next update
# replaces it (and gets the marker) instead of refusing to touch it.
is_legacy_shim() {
  local path="$1" size
  [ -f "$path" ] && [ ! -L "$path" ] || return 1
  size="$(wc -c < "$path" 2>/dev/null || echo 0)"
  [ "$size" -le 1024 ] || return 1
  grep -qF 'omarchy-snote-plugin/app/dist/cli.js' "$path" 2>/dev/null
}

# --- Symlink/ownership guard --------------------------------------------
# Everything below this point either (a) copies the pre-built payload into
# a fresh directory under $plugin_dir and swaps it into place, or (b)
# writes the ~/.local/bin/snote shim. Both are destructive-adjacent: the
# original version of this script ran a `sync -a --delete` straight into
# the existing $app_dir, and sync with --delete, unlike plain rm, *follows*
# a destination symlink and then deletes, inside whatever real directory
# that symlink points to, anything not present in the source tree.
#
# Unlike the base directories above, $plugin_dir and $app_dir ARE this
# installer's own: nothing else should legitimately replace either with a
# symlink, since they're exactly the paths setup itself creates and
# writes into. If either had been swapped for a symlink — by an attacker,
# a leftover from another tool, or just a stale mount — first-click setup
# would silently copy into, and prune files from, an unrelated directory.
# So these two get a hard refusal rather than realpath's "resolve through
# it" treatment.
#
# The design is two-fold and unchanged:
#   1. Refuse outright, before doing anything else, if plugin_dir or
#      app_dir already exists and is a symlink. This is deliberately one
#      of the first things the script does after computing paths, so it
#      is cheap to test and can't be skipped by any later early-exit
#      (including `--check`).
#   2. Never write into a path that could have been swapped for a symlink
#      between this check and the write. Instead, stage into a brand-new
#      directory this script creates itself with `mktemp -d` *inside* the
#      now-verified $plugin_dir, and only ever `mv` (an atomic rename
#      within the same filesystem, not a recursive copy/delete) the
#      finished payload into $app_dir's place. A plain `mv` replaces the
#      destination directory entry itself — it does not dereference a
#      destination symlink the way the old delete-style sync or a shell
#      `>` redirect does — so even a last-instant symlink swap can't
#      redirect that step.
assert_not_symlink() {
  # $1 = human label for the message, $2 = path to check
  if [ -L "$2" ]; then
    fail "$1 ($2) is a symlink; refusing to build or write there. Remove the symlink (or point $1 at a real directory) and re-run."
  fi
}
assert_not_symlink "the plugin data directory" "$plugin_dir"
assert_not_symlink "the build directory" "$app_dir"
assert_not_symlink "the previous build" "$prev_dir"
assert_not_symlink "the run lock" "$run_lock"
assert_not_symlink "the rolled-back mark" "$rolled_back_mark"
assert_not_symlink "the checked mark" "$checked_mark"

# Same reasoning for the shim path: the original script wrote it with a
# plain `cat > "$shim"` redirect, which — just like the old delete-style
# sync above — follows a destination symlink and writes through it. And
# even when $shim is an ordinary file rather than a symlink, overwriting
# it is only safe if this installer is the one that wrote it (or it's a
# pre-marker legacy shim, see is_legacy_shim above); otherwise it's
# someone else's file at that path. Check all of this up front, for the
# same reasons as above: cheap, first, nothing else needed to find out.
# $bin_dir itself is a base/resolved directory (see above) and is never
# refused for being a symlink; only the shim file it contains is.
mkdir -p "$bin_dir"
if [ -L "$shim" ]; then
  fail "$shim is a symlink; refusing to write through it. Remove it manually and re-run."
fi
if [ -e "$shim" ] && ! grep -qF "$shim_marker" "$shim" 2>/dev/null && ! is_legacy_shim "$shim"; then
  fail "$shim already exists and was not created by this installer (no snote marker found in it); refusing to overwrite it. Move it aside and re-run."
fi

# The clone's own version, now a plain cat of plugin-dist/VERSION — the
# version stamp the build wrote next to the pre-built files. Used both
# for the idempotent fast path and to stamp $app_dir/VERSION after the
# copy, so later checks (here and in BarWidget.qml) never need to invoke
# node either.
if [ ! -d "$dist_dir" ]; then
  fail "pre-built files not found: $dist_dir does not exist in this plugin clone. Re-install/update the plugin so it ships plugin-dist/."
fi
if [ ! -f "$dist_dir/cli.js" ]; then
  fail "pre-built files incomplete: $dist_dir/cli.js is missing. Re-install/update the plugin so it ships a complete plugin-dist/."
fi
source_version="$(cat "$dist_dir/VERSION" 2>/dev/null || true)"
[ -n "$source_version" ] || fail "could not read a version from $dist_dir/VERSION"

# --- Node lookup ----------------------------------------------------------
# Deliberately fixed-path: /usr/bin/node first, then what /usr/bin/mise
# (absolute, so an inherited PATH can't redirect the lookup) reports for
# `mise which node`. A bare `node` from PATH is never used, because the
# marketplace's own reviews (issues #6461/#6564-style findings) object to
# a launcher depending on whatever node the caller's PATH happens to
# carry. A candidate is accepted only when it actually runs and reports
# major version 22 or newer. SNOTE_NODE, when set, is checked first at run time,
# both by setup here and by the generated shim, for whoever runs snote: the
# tests use it, and anyone who sets SNOTE_NODE in their environment chooses
# the Node binary themselves, like PATH. When no usable Node is found,
# setup runs Omarchy's own installer (omarchy-install-dev-env node) and
# looks again; snote itself never fetches Node.
node_message="snote needs Node.js 22 or newer. Install it with: omarchy-install-dev-env node"

node_is_usable() {
  local candidate="$1" major
  [ -f "$candidate" ] && [ -x "$candidate" ] || return 1
  major="$(env -u NODE_OPTIONS "$candidate" --version 2>/dev/null | sed -n 's/^v\([0-9][0-9]*\).*/\1/p' | head -n1)" || true
  [ -n "$major" ] || return 1
  [ "$major" -ge 22 ] 2>/dev/null
}

find_node() {
  local candidate
  if [ -n "${SNOTE_NODE:-}" ]; then
    if node_is_usable "$SNOTE_NODE"; then
      printf '%s\n' "$SNOTE_NODE"
      return 0
    fi
    return 1
  fi
  if node_is_usable /usr/bin/node; then
    printf '%s\n' /usr/bin/node
    return 0
  fi
  if [ -x /usr/bin/mise ]; then
    candidate="$(/usr/bin/mise which node 2>/dev/null)" || return 1
    if node_is_usable "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi
  return 1
}

# Locate Omarchy's own dev-env installer so a missing Node can be
# installed through Omarchy rather than downloaded by snote. Same
# fixed-path policy as find_node above: never a bare name from PATH.
# SNOTE_DEV_ENV_INSTALLER is an override that is honoured ONLY when
# SNOTE_NODE is also set, so a stray env var can never
# make a real user's setup exec an arbitrary program. Prints the
# installer path, or returns 1 when there is none.
dev_env_installer() {
  if [ -n "${SNOTE_NODE:-}" ]; then
    if [ -n "${SNOTE_DEV_ENV_INSTALLER:-}" ] && [ -x "$SNOTE_DEV_ENV_INSTALLER" ]; then
      printf '%s\n' "$SNOTE_DEV_ENV_INSTALLER"
      return 0
    fi
    return 1
  fi
  if [ -x /usr/share/omarchy/bin/omarchy-install-dev-env ]; then
    printf '%s\n' /usr/share/omarchy/bin/omarchy-install-dev-env
    return 0
  fi
  return 1
}

# --- Never replace the build under a running snote (#67) -------------------
# The shim setup writes holds a shared flock on $run_lock for snote's whole
# life (the fd stays open across exec), so an exclusive non-blocking flock
# here fails exactly while a snote started through that shim is running, and
# a snote started while setup holds it waits in the shim until the swap is
# done. The lock file is not snote's data folder: nothing here reads or
# writes that. Processes started by an older shim (0.2.7, no lock) are found
# by their command line instead: any process whose argument is this build's
# cli.js. The lock stays held until setup exits (or closes fd 9 below).
snote_proc_running() {
  local f
  for f in $(printf '%s\n' "$app_dir/cli.js" "$prev_dir/cli.js" | grep -alsF -f - /proc/[0-9]*/cmdline); do
    if tr '\0' '\n' < "$f" 2>/dev/null | grep -qxF -e "$app_dir/cli.js" -e "$prev_dir/cli.js"; then
      return 0
    fi
  done
  return 1
}
acquire_run_lock() {
  [ -x /usr/bin/flock ] || fail "flock is required but was not found at /usr/bin/flock"
  assert_not_symlink "the run lock" "$run_lock"
  ( umask 077; : >> "$run_lock" )
  exec 9>> "$run_lock"
  if ! /usr/bin/flock -n -x 9 || snote_proc_running; then
    fail "snote is running: quit it and run setup again"
  fi
}

# Leftover directories of a killed run (#67): app.XXXXXX (a stage),
# app.failed.<pid> and app.rolledback.<pid> (a restore), check.XXXXXX (a start
# check). Called with the exclusive lock held, so none of them can be live.
# Only real directories directly in $plugin_dir whose names have exactly these
# shapes are removed (six letters or digits, or a pid of digits only): a
# symlink with such a name is left alone, so are app and app.prev, and nothing
# outside $plugin_dir is looked at.
clean_stage_leftovers() {
  local d
  for d in "$plugin_dir"/app.[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9] \
           "$plugin_dir"/check.[A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9] \
           "$plugin_dir"/app.failed.[0-9]* "$plugin_dir"/app.rolledback.[0-9]*; do
    case "${d##*.}" in ''|*[!A-Za-z0-9]*) continue ;; esac
    case "$d" in "$plugin_dir"/app.failed.*|"$plugin_dir"/app.rolledback.*)
      case "${d##*.}" in *[!0-9]*) continue ;; esac ;;
    esac
    if [ -d "$d" ] && [ ! -L "$d" ]; then rm -rf "$d"; fi
  done
}

# Start check (#67): after the swap, before the shim is touched, the new build
# must print its own version. It runs with an isolated environment: a temp
# HOME and temp XDG_* directories (no token, no snote data folder), nothing
# inherited from the caller, a 10 s limit where timeout exists.
start_check_passes() {
  local node_bin chk out limit=""
  node_bin="$(find_node)" || return 1
  [ -x /usr/bin/timeout ] && limit="/usr/bin/timeout 10"
  chk="$(mktemp -d "$plugin_dir/check.XXXXXX")" || return 1
  mkdir -p "$chk/home" "$chk/data" "$chk/config" "$chk/state" "$chk/cache"
  out="$(env -i PATH=/usr/bin:/bin HOME="$chk/home" XDG_DATA_HOME="$chk/data" \
    XDG_CONFIG_HOME="$chk/config" XDG_STATE_HOME="$chk/state" XDG_CACHE_HOME="$chk/cache" \
    SNOTE_UPDATE_CHECK=off $limit "$node_bin" "$app_dir/cli.js" --version 2>/dev/null 9>&-)" || out=""
  rm -rf "$chk"
  [ "${out##* }" = "$source_version" ]
}

# The checked mark (#67): $plugin_dir/checked holds the VERSION of the build
# whose start check passed. It lives in the 0700 plugin directory beside the
# rolled-back mark (the build directory is renamed away and replaced, so a
# mark inside it would not outlive the swap), is written with mktemp (0600)
# and a rename, and is only ever written AFTER the start check passes. An
# installed build is "current" only while this names its VERSION, so a setup
# killed during the start check leaves no mark and the next run checks again.
build_checked() {
  [ -f "$checked_mark" ] && [ ! -L "$checked_mark" ] && [ "$(cat "$checked_mark")" = "$1" ]
}
write_checked_mark() {
  local t
  assert_not_symlink "the checked mark" "$checked_mark"
  t="$(mktemp "$plugin_dir/.checked.XXXXXX")"
  printf '%s\n' "$1" > "$t"
  mv "$t" "$checked_mark"
}

# --check: used by BarWidget.qml to decide, without opening a terminal,
# whether a click can launch straight away or needs to route through this
# script's visible install path first. Exits 0 when the installed app's
# VERSION file already matches this clone's plugin-dist/VERSION, 1
# otherwise (including "nothing installed yet" and "the symlink guard
# above fired"). No node call, no side effects.
if [ "${1:-}" = "--check" ]; then
  [ -f "$app_dir/VERSION" ] || exit 1
  if [ "$(cat "$app_dir/VERSION")" = "$source_version" ] && build_checked "$source_version"; then exit 0; fi
  # Rolled back from exactly the version this clone ships: still "current" (see --rollback).
  [ -f "$rolled_back_mark" ] && [ ! -L "$rolled_back_mark" ] && [ "$(cat "$rolled_back_mark")" = "$source_version" ]
  exit $?
fi

# --rollback (#67): bring the previous build back. It refuses while snote runs
# (the same lock and the same message as an install). app.prev becomes app and
# the build it replaces is removed, so there is no second previous build.
# The version rolled back from is written to $rolled_back_mark, so --check
# keeps saying "current" while the clone still ships exactly that version:
# the bar must not reinstall at once what the user just rolled back. An
# install (by hand, or after the clone moves to another version) clears it.
# Between the two renames the shim runs app.prev, which is the build wanted.
if [ "${1:-}" = "--rollback" ]; then
  [ -f "$prev_dir/cli.js" ] || fail "no previous build to roll back to"
  acquire_run_lock
  [ -f "$prev_dir/cli.js" ] || fail "no previous build to roll back to"
  rolled_from=""
  if [ -f "$app_dir/VERSION" ]; then
    rolled_from="$(cat "$app_dir/VERSION")"
  fi
  if [ -n "$rolled_from" ]; then
    mark_tmp="$(mktemp "$plugin_dir/.rolled-back.XXXXXX")"
    printf '%s\n' "$rolled_from" > "$mark_tmp"
    mv "$mark_tmp" "$rolled_back_mark"
  fi
  if [ -e "$app_dir" ]; then
    assert_not_symlink "the build directory" "$app_dir"
    gone_dir="${app_dir}.rolledback.$$"
    mv "$app_dir" "$gone_dir"
    mv "$prev_dir" "$app_dir"
    # The keys of the build just replaced stay (SG-4): a key removed by a verified
    # update must not be trusted again because an older build is back.
    if [ -f "$gone_dir/allowed_signers" ] && [ ! -L "$gone_dir/allowed_signers" ]; then
      signers_tmp="$(mktemp "$app_dir/.allowed_signers.XXXXXX")"
      cp "$gone_dir/allowed_signers" "$signers_tmp"
      chmod 644 "$signers_tmp"
      mv "$signers_tmp" "$app_dir/allowed_signers"
    fi
    rm -rf "$gone_dir"
  else
    mv "$prev_dir" "$app_dir"
  fi
  log "rolled back: snote $(cat "$app_dir/VERSION" 2>/dev/null || echo unknown) is installed again"
  exit 0
fi

# --- Pre-built payload ----------------------------------------------------
# Check Node before the idempotent fast path: a re-run on a machine whose
# Node went away still ends with the same actionable one-line message.
# When Node is missing and Omarchy's own installer is present, run it
# first (this script already runs in the visible setup terminal) and look
# again; only if Node is still missing does setup give up. The installer's
# own exit status is ignored — what matters is whether Node is there after.
if ! find_node >/dev/null; then
  if installer="$(dev_env_installer)"; then
    log "Node.js 22 or newer was not found; installing it through Omarchy (omarchy-install-dev-env node)..."
    "$installer" node || true
  fi
  if ! find_node >/dev/null; then
    printf '%s\n' "$node_message" >&2
    exit 1
  fi
fi

# Idempotent fast path: skip the re-copy if the installed app's VERSION
# file already matches the clone's plugin-dist/VERSION and the payload is
# there. Plain text compare; find_node above only ran the cheap
# `--version` probes, no build and no download.
if [ -x "$shim" ] && [ -f "$app_dir/VERSION" ] && [ -f "$app_dir/cli.js" ] \
   && [ "$(cat "$app_dir/VERSION")" = "$source_version" ]; then
  if ! build_checked "$source_version"; then
    # Same version, but no start check passed for it (a setup killed during
    # the check): check it now. If it does not start, put app.prev back.
    log "Checking that the installed snote $source_version starts..."
    if start_check_passes; then
      write_checked_mark "$source_version"
    else
      acquire_run_lock
      if [ -f "$prev_dir/cli.js" ]; then
        assert_not_symlink "the previous build" "$prev_dir"
        failed_dir="${app_dir}.failed.$$"
        mv "$app_dir" "$failed_dir"
        mv "$prev_dir" "$app_dir"
        kept_version="$(cat "$app_dir/VERSION" 2>/dev/null || echo unknown)"
        rm -rf "$failed_dir"
        fail "update failed: kept $kept_version"
      fi
      fail "install failed: the installed build did not start"
    fi
  fi
  log "snote $source_version is already installed at $app_dir — nothing to do."
  exit 0
fi

log "Installing pre-built snote from $dist_dir into a fresh directory under $plugin_dir..."
mkdir -p "$plugin_dir"
# Re-check right before creating anything: mkdir -p above is a no-op if
# plugin_dir already existed, but if it was swapped for a symlink in the
# instant between the guard above and here, this still catches it before
# mktemp would create a directory inside an attacker-chosen location.
assert_not_symlink "the plugin data directory" "$plugin_dir"
chmod 700 "$plugin_dir"
acquire_run_lock
clean_stage_leftovers

stage_tmp="$(mktemp -d "$plugin_dir/app.XXXXXX")"
# Clean up the scratch directory on any failure path; cleared right before
# the final swap below once stage_tmp has successfully become app_dir.
trap 'rm -rf "$stage_tmp"' EXIT

# cp -R of the plugin-dist payload only (no sync tool, and no --delete in
# any form: stage_tmp is always empty when we write into it).
cp -R "$dist_dir"/. "$stage_tmp"/

[ -f "$stage_tmp/cli.js" ] || fail "install failed: $stage_tmp/cli.js is missing after copying $dist_dir"

# The version stamp travels with the payload: plugin-dist/VERSION becomes
# $app_dir/VERSION as-is.
printf '%s\n' "$source_version" > "$stage_tmp/VERSION"

# The staged copy must be exactly the files the release lists (#68, MUST 10).
# The clone's SHA256SUMS was verified (signature and every sum) by the running
# build before the clone was moved to this commit, so setup does not check the
# signature again; it hashes the copy it just made, because that is what gets
# installed and the clone's files could have changed since that check
# (CWE-367). Every staged file must be a verbatim copy of a plugin-dist/<path>
# line of the manifest, and every such line must have its file; a symlink or
# any other special file is refused. With no SHA256SUMS in the clone (setup run
# directly in a development checkout, or a clone from a release before
# signing) nothing is checked: the documented manual path (SECURITY.md).
refuse_unverified() {
  printf '%s\n' 'update refused: the download could not be verified' >&2
  exit 1
}
verify_stage_against_manifest() {
  local sums="$src_dir/SHA256SUMS"
  if [ ! -e "$sums" ] && [ ! -L "$sums" ]; then
    # The update path (the helper) passes --verified-update: a clone it just verified must hold SHA256SUMS.
    if [ "${1:-}" = "--verified-update" ]; then refuse_unverified; fi
    log "No SHA256SUMS in $src_dir: installing without a manifest check (a development checkout or an older release)."
    return 0
  fi
  if [ ! -f "$sums" ] || [ -L "$sums" ]; then refuse_unverified; fi
  if [ -n "$(find "$stage_tmp" ! -type f ! -type d -print -quit)" ]; then refuse_unverified; fi
  cmp -s <(sed -n 's#^\([0-9a-f]\{64\}\)  plugin-dist/\(..*\)$#\1  \2#p' "$sums" | LC_ALL=C sort) \
         <(cd "$stage_tmp" && find . -type f -print0 | LC_ALL=C sort -z \
             | while IFS= read -r -d '' f; do printf '%s  %s\n' "$(sha256sum < "$f" | cut -d' ' -f1)" "${f#./}"; done \
             | LC_ALL=C sort) || refuse_unverified
}
# The release keys (SG-2): a symlink named allowed_signers is never installed.
if [ -L "$stage_tmp/allowed_signers" ]; then
  fail "allowed_signers in the build is a symlink; refusing to install it"
fi
verify_stage_against_manifest "${1:-}"
# Modes come from this fixed list, not from the tree: directories 0700, cli.js
# 0755, every other file 0644 (so allowed_signers is 0644 and nothing is group-
# or world-writable, whatever the clone or the umask said).
find "$stage_tmp" -type d -exec chmod 700 {} +
find "$stage_tmp" -type f -exec chmod 644 {} +
if [ -f "$stage_tmp/cli.js" ]; then chmod 755 "$stage_tmp/cli.js"; fi

# The shim (#67): written BEFORE the two renames when a build is already
# there, so a shim from an older install (no app.prev fallback) is replaced
# while a runnable snote still exists: a kill between the renames then leaves
# a shim that starts app.prev. A first install writes it after the start
# check, so a build that does not start leaves no shim.
install_shim() {
log "Installing the snote shim at $shim..."
# Re-check right before writing (same TOCTOU reasoning as the app_dir
# re-checks above): the real guard already ran, up top, first thing; this
# just covers the instant between that check and this write.
if [ -L "$shim" ]; then
  fail "$shim is a symlink; refusing to write through it. Remove it manually and re-run."
fi
# Write to a scratch file next to the shim and `mv` it into place: mv
# replaces the destination entry directly, so even if something recreated
# $shim as a symlink in the instant after the checks above, the swap still
# can't write through it the way a direct `cat > "$shim"` redirect would.
# This also cleanly replaces a legacy (pre-marker) shim that passed the
# guard above: it's simply overwritten with the marked version, same as
# any other re-install.
shim_tmp="$(mktemp "$bin_dir/.snote-shim.XXXXXX")"
# The shim resolves Node at RUN time with the exact same fixed-path lookup
# as find_node above (so a Node upgrade through mise keeps working without
# re-running setup), and clears NODE_OPTIONS from the child's environment
# with `env -u` so a caller's NODE_OPTIONS can never leak into snote.
# The shim checks SNOTE_NODE first: when set it is the caller's explicit
# choice of Node binary. Unlike setup, which stops when SNOTE_NODE is
# unusable, the shim skips an unusable SNOTE_NODE at run time and tries
# /usr/bin/node, then mise.
# Each candidate is probed with `env -u NODE_OPTIONS` too, so an invalid
# NODE_OPTIONS in the caller's environment can't make a good Node look
# missing, and a candidate that is executable but too old does not stop
# the walk: the shim keeps trying the next one, in find_node's order.
# $app_dir is embedded single-quoted (every ' escaped as '\'') rather
# than inside double quotes, so a path containing shell metacharacters
# can never be reinterpreted when the shim runs.
app_dir_quoted="'$(printf '%s' "$app_dir" | sed "s/'/'\\\\''/g")'"
run_lock_quoted="'$(printf '%s' "$run_lock" | sed "s/'/'\\\\''/g")'"
cat > "$shim_tmp" <<EOF
#!/bin/sh
$shim_marker
# Resolve Node at run time; never from PATH.
node=""
for candidate in "\${SNOTE_NODE:-}" /usr/bin/node; do
  [ -n "\$candidate" ] || continue
  if [ -f "\$candidate" ] && [ -x "\$candidate" ]; then
    major="\$(env -u NODE_OPTIONS "\$candidate" --version 2>/dev/null | sed -n 's/^v\([0-9][0-9]*\).*/\1/p' | head -n1)"
    if [ -n "\$major" ] && [ "\$major" -ge 22 ] 2>/dev/null; then node="\$candidate"; break; fi
  fi
done
if [ -z "\$node" ] && [ -x /usr/bin/mise ]; then
  # The probe starts clean (env -i, PATH=/usr/bin:/bin, HOME = this
  # caller's home) but keeps the caller's XDG and MISE directory
  # variables, each carried through by name only when set and
  # non-empty, so mise finds a Node installed under custom XDG or
  # mise directories; a stray NODE_OPTIONS is still dropped. The
  # options are built inside a throwaway subshell (their own command
  # substitutions, expanded after env with only a newline as the word
  # splitter), so the shim's positional parameters still hold the
  # user's arguments for the exec below; nothing is re-parsed or
  # run through a shell string here, so a value with spaces or a
  # single quote reaches mise
  # byte for byte. The result is still only accepted after its own
  # env -u NODE_OPTIONS version check below.
  candidate="\$(
    IFS='
'
    /usr/bin/env -i \
      \$(t=XDG_CONFIG_HOME; v=\$(printenv XDG_CONFIG_HOME); [ -n "\$v" ] && printf '%s=%s' "\$t" "\$v") \
      \$(t=XDG_DATA_HOME; v=\$(printenv XDG_DATA_HOME); [ -n "\$v" ] && printf '%s=%s' "\$t" "\$v") \
      \$(t=XDG_CACHE_HOME; v=\$(printenv XDG_CACHE_HOME); [ -n "\$v" ] && printf '%s=%s' "\$t" "\$v") \
      \$(t=XDG_STATE_HOME; v=\$(printenv XDG_STATE_HOME); [ -n "\$v" ] && printf '%s=%s' "\$t" "\$v") \
      \$(t=MISE_DATA_DIR; v=\$(printenv MISE_DATA_DIR); [ -n "\$v" ] && printf '%s=%s' "\$t" "\$v") \
      \$(t=MISE_CONFIG_DIR; v=\$(printenv MISE_CONFIG_DIR); [ -n "\$v" ] && printf '%s=%s' "\$t" "\$v") \
      \$(t=MISE_GLOBAL_CONFIG_FILE; v=\$(printenv MISE_GLOBAL_CONFIG_FILE); [ -n "\$v" ] && printf '%s=%s' "\$t" "\$v") \
      PATH=/usr/bin:/bin HOME="\$HOME" /usr/bin/mise which node 2>/dev/null
  )" || candidate=""
  if [ -n "\$candidate" ] && [ -f "\$candidate" ] && [ -x "\$candidate" ]; then
    major="\$(env -u NODE_OPTIONS "\$candidate" --version 2>/dev/null | sed -n 's/^v\([0-9][0-9]*\).*/\1/p' | head -n1)"
    if [ -n "\$major" ] && [ "\$major" -ge 22 ] 2>/dev/null; then node="\$candidate"; fi
  fi
fi
if [ -z "\$node" ]; then
  echo "$node_message" >&2
  exit 1
fi
run_lock=$run_lock_quoted
# Hold a shared lock for snote's whole life: fd 9 stays open across exec, so
# setup's exclusive lock fails while snote runs, and a snote started during
# setup's swap waits here until the new build is complete.
if [ -x /usr/bin/flock ] && [ -f "\$run_lock" ] && [ ! -L "\$run_lock" ] && [ -w "\$run_lock" ]; then
  exec 9>>"\$run_lock" && /usr/bin/flock -s 9
fi
# Between setup's two renames there is no app/cli.js: run the kept build.
if [ ! -f $app_dir_quoted/cli.js ] && [ -f $app_dir_quoted.prev/cli.js ]; then
  exec env -u NODE_OPTIONS "\$node" $app_dir_quoted.prev/cli.js "\$@"
fi
exec env -u NODE_OPTIONS "\$node" $app_dir_quoted/cli.js "\$@"
EOF
chmod +x "$shim_tmp"
mv "$shim_tmp" "$shim"
}

# Swap the payload into place (#67). The finished stage is renamed in, and the
# build it replaces is kept as app.prev (exactly one copy: the older one is
# removed first). Both steps are same-filesystem renames of the directory
# entry itself, so neither follows a destination symlink. If setup is killed
# between the two renames there is no $app_dir for a moment, and the shim runs
# app.prev instead, so a runnable snote is always there. A leftover app.prev
# with no $app_dir (that very kill) is kept as it is.
rm -f "$checked_mark"
had_build=0
if [ -e "$app_dir" ] || [ -d "$prev_dir" ]; then had_build=1; install_shim; fi
if [ -e "$app_dir" ]; then
  assert_not_symlink "the build directory" "$app_dir"
  assert_not_symlink "the previous build" "$prev_dir"
  rm -rf "$prev_dir"
  mv "$app_dir" "$prev_dir"
fi
mv "$stage_tmp" "$app_dir"
trap - EXIT

# The new build must start (#67): if it does not, put the previous build back
# and say so in one sentence. A first install writes its shim only after this passes.
if ! start_check_passes; then
  failed_dir="${app_dir}.failed.$$"
  mv "$app_dir" "$failed_dir"
  if [ -d "$prev_dir" ]; then
    mv "$prev_dir" "$app_dir"
    kept_version="$(cat "$app_dir/VERSION" 2>/dev/null || echo unknown)"
    rm -rf "$failed_dir"
    fail "update failed: kept $kept_version"
  fi
  rm -rf "$failed_dir"
  fail "install failed: the new build did not start, so nothing was installed"
fi
rm -f "$rolled_back_mark"
write_checked_mark "$source_version"
if [ "$had_build" = 0 ]; then install_shim; fi

case ":$PATH:" in
  *":$bin_dir:"*) ;;
  *)
    log "Warning: $bin_dir is not on PATH in this shell."
    log "Add it in your shell's own rc file, e.g.: export PATH=\"$bin_dir:\$PATH\""
    ;;
esac

log "snote is installed. Launching it now..."
# Release the run lock first: the shim takes a shared lock on it.
exec 9>&-
"$shim" --version >/dev/null 2>&1 || true
exit 0
