#!/bin/bash
# Remove what packaging/omarchy/setup installed: the ~/.local/bin/snote shim
# and the omarchy-snote-plugin build directory. Does not touch snote's own
# data directory (~/.local/share/snote — notes cache, auth token) or the
# plugin clone itself (remove that with
# `omarchy plugin remove io.github.donnishcomau.snote`).
set -eu

app_dir="${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-snote-plugin"
shim="$HOME/.local/bin/snote"

log() { printf '==> %s\n' "$1"; }

if [ -e "$shim" ]; then
  rm -f "$shim"
  log "removed $shim"
else
  log "$shim was not present"
fi

if [ -d "$app_dir" ]; then
  rm -rf "$app_dir"
  log "removed $app_dir"
else
  log "$app_dir was not present"
fi
