{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": false, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "noEmit": true, "allowJs": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".", "paths": { "@vendor/*": ["vendor/simplenote/*"] }
  },
  "include": ["src", "test", "scripts/*.ts"]
}
